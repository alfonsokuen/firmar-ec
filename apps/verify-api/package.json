{
  "name": "@firma-ec/verify-api",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Public PAdES verification API for firmar.ec — Fastify + @firma-ec/verifier. Handles NO private keys.",
  "scripts": {
    "dev": "node build.mjs --watch",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest": "node build.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.0",
    "@firma-ec/crypto-core": "workspace:^",
    "@firma-ec/tsl-ec": "workspace:^",
    "@firma-ec/verifier": "workspace:^",
    "asn1js": "^3.0.5",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.1.0",
    "pino": "^9.5.0",
    "pkijs": "^3.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
