{
  "name": "@firma-ec/pwa",
  "version": "0.26.3",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm -w build:tsl && vite build && node ../../scripts/check-wa-number.mjs dist && node ../../scripts/check-app-version.mjs dist",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:live-signing": "playwright test --config playwright.live-signing.config.ts",
    "test:e2e:mobile": "playwright test --project=mobile",
    "test:e2e:sw": "playwright test --config playwright.sw.config.ts"
  },
  "dependencies": {
    "@firma-ec/inbox-crypto": "workspace:^",
    "@firma-ec/signer": "workspace:^",
    "@firma-ec/tsa-client": "workspace:^",
    "@firma-ec/tsl-ec": "workspace:^",
    "@firma-ec/verifier": "workspace:^",
    "@iconify-json/lucide": "^1.2.105",
    "@unocss/preset-icons": "^66.6.8",
    "@unocss/preset-typography": "^66.6.8",
    "@unocss/preset-wind4": "^66.6.8",
    "@unocss/transformer-directives": "^66.6.8",
    "@unocss/transformer-variant-group": "^66.6.8",
    "pdfjs-dist": "^4",
    "svelte": "^5.56.8",
    "svelte-spa-router": "^5.1.0",
    "unocss": "^66.6.8",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.59.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/node-forge": "^1.3.14",
    "fast-check": "^3.23.2",
    "lightningcss": "^1.28.0",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "svelte-check": "^4.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1"
  }
}
