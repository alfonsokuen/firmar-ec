{
  "name": "@firma-ec/landing",
  "version": "0.7.5",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && node scripts/check-size-claims.mjs && node --experimental-strip-types scripts/check-announced-urls.mjs && astro build && node scripts/check-llms.mjs && node scripts/check-faq-visibility.mjs && node scripts/check-answer-pages.mjs && node scripts/check-nav-links.mjs && node ../../scripts/check-wa-number.mjs dist",
    "preview": "astro preview --host 0.0.0.0",
    "typecheck": "astro check",
    "og:aliases": "node --experimental-strip-types scripts/generate-og-aliases.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/svelte": "^7.2.5",
    "@iconify-json/lucide": "^1.2.105",
    "@resvg/resvg-js": "^2.6.2",
    "@unocss/astro": "^66.6.8",
    "@unocss/preset-icons": "^66.6.8",
    "@unocss/preset-typography": "^66.6.8",
    "@unocss/preset-wind4": "^66.6.8",
    "@unocss/transformer-directives": "^66.6.8",
    "@unocss/transformer-variant-group": "^66.6.8",
    "astro": "^5.1.0",
    "geist": "^1.7.0",
    "satori": "^0.26.0",
    "sharp": "^0.33.5",
    "svelte": "^5.56.8",
    "unocss": "^66.6.8"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
