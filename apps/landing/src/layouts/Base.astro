---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SkipLink from '../components/SkipLink.astro';
import TopicLinks from '../components/TopicLinks.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import type { Lang } from '../i18n/ui.ts';
import { getLangFromUrl, useTranslations } from '../i18n/utils.ts';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonld?: object[];
  routeKey?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage,
  ogType,
  jsonld = [],
  routeKey,
  noindex,
} = Astro.props;
const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

let hreflangs: { es?: string; en?: string } = {};
if (routeKey) {
  const { getHreflangsForRoute } = await import('../i18n/utils.ts');
  const r = getHreflangsForRoute(routeKey);
  if (r) hreflangs = r;
}
---
<!doctype html>
<html lang={lang === 'es' ? 'es-EC' : 'en-US'} data-theme-default="light">
  <head>
    <script is:inline>
      // F6.3 — backward-compat redirect: signed PDFs from F3–F6.2 versions
      // encoded the QR URL as `firmar.ec/#/verificar?h=<hex>`. The landing
      // (Astro) doesn't handle SPA hash routes, so forward any hash matching
      // a known PWA route to `app.firmar.ec`, preserving the hash. Runs
      // BEFORE BaseHead/theme/render so users don't see a landing flash.
      (function () {
        try {
          var h = window.location.hash;
          if (h && /^#\/(verificar|firmar|paranoia|about|configuracion)/.test(h)) {
            window.location.replace('https://app.firmar.ec/' + h);
          }
        } catch (_) { /* no-op */ }
      })();
    </script>
    <BaseHead
      title={title}
      description={description}
      lang={lang}
      jsonld={jsonld}
      hreflangs={hreflangs}
      {...(canonical !== undefined && { canonical })}
      {...(ogImage !== undefined && { ogImage })}
      {...(ogType !== undefined && { ogType })}
      {...(noindex !== undefined && { noindex })}
    />
    <script is:inline>
      // Default LIGHT, but follow the device when the user has not chosen.
      // Priority: explicit user choice (localStorage 'theme' = 'light'|'dark')
      // wins; otherwise match prefers-color-scheme (dark device → dark),
      // falling back to light. Set pre-render to avoid FOUC.
      (() => {
        try {
          const saved = localStorage.getItem('theme');
          let theme;
          if (saved === 'dark' || saved === 'light') {
            theme = saved;
          } else {
            theme = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
          }
          document.documentElement.dataset.theme = theme;
        } catch (_) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
    <meta name="view-transition" content="same-origin" />
  </head>
  <body class="font-sans bg-ink-50 text-ink-900 dark:bg-ink-950 dark:text-ink-100 min-h-dvh flex flex-col antialiased">
    <SkipLink href="#main">{t('skip.main')}</SkipLink>
    <Header />
    <main id="main" class="flex-1" tabindex="-1">
      <slot />
      <div class="container-narrow">
        <TopicLinks />
      </div>
    </main>
    <Footer />
    <WhatsAppFab />
    <script is:inline>
      // Scroll-entry reveals: marca html[data-reveal] (gate del CSS) y observa
      // los [data-reveal]. IO once-per-elemento; sin JS el contenido queda visible.
      (function () {
        if (!('IntersectionObserver' in window)) return;
        document.documentElement.setAttribute('data-reveal', '');
        var init = function () {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add('reveal-in');
                io.unobserve(e.target);
              }
            });
          }, { rootMargin: '0px 0px -8% 0px' });
          document.querySelectorAll('[data-reveal]').forEach(function (el) { io.observe(el); });
        };
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
        else init();
      })();
    </script>
  </body>
</html>
