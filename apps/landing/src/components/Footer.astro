---
import { getLangFromUrl, localizedUrl, useTranslations } from '../i18n/utils.ts';
import { SITE } from '../lib/jsonld.ts';
import { storeLink } from '../lib/store.ts';
import IdkmanagerMark from './IdkmanagerMark.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
const buyUrl = storeLink('footer');
---
<footer class="border-t border-ink-200 dark:border-ink-800 mt-16">
  <div class="container py-12 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-6">
    <div class="lg:col-span-2">
      <p class="font-display text-base font-bold tracking-tight">
        <span class="text-brand-500">firmar</span><span class="text-ink-500">.ec</span>
      </p>
      <p class="mt-3 text-sm text-ink-600 dark:text-ink-400 max-w-prose">
        {lang === 'es'
          ? 'PWA pública ecuatoriana de firma y verificación de PDFs. Open source. Cumple LOPDP por diseño.'
          : 'Ecuadorian public PWA for signing and verifying PDFs. Open source. LOPDP-compliant by design.'}
      </p>
      <p class="mt-3 text-xs text-ink-500 flex items-center flex-wrap gap-x-2 gap-y-1">
        <span>{t('footer.operado')}</span>
        <a
          class="inline-flex items-center gap-1.5 text-ink-700 dark:text-ink-300 hover:text-brand-500 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 focus-visible:ring-offset-ink-50 dark:focus-visible:ring-offset-ink-950 rounded"
          href={SITE.operatorUrl}
          aria-label="IDKMANAGER — idkmanager.com"
        >
          <IdkmanagerMark size="sm" />
          <span class="i-lucide-arrow-up-right text-xs opacity-60" aria-hidden="true"></span>
        </a>
      </p>
      <a
        href="https://app.firmar.ec/"
        data-cta="abrir_app"
        class="mt-5 inline-flex items-center gap-2 h-11 px-3.5 rounded-md bg-brand-500 text-white text-sm font-semibold shadow-[0_4px_16px_-4px_color-mix(in_oklch,oklch(52%_0.18_240)_50%,transparent)] ring-1 ring-brand-600/30 hover:-translate-y-px hover:shadow-[0_8px_24px_-4px_color-mix(in_oklch,oklch(52%_0.18_240)_60%,transparent)] transition-[transform,box-shadow] duration-200 ease-[cubic-bezier(0.32,0.72,0,1)]"
      >
        <span>{t('cta.abrir_app_full')}</span>
        <span class="i-lucide-arrow-up-right text-base" aria-hidden="true"></span>
      </a>
      <p class="mt-3">
        <a
          class="inline-flex items-center gap-2 h-11 px-3.5 rounded-md text-sm font-semibold shadow-sm hover:opacity-90 transition-opacity focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 focus-visible:ring-offset-ink-50 dark:focus-visible:ring-offset-ink-950"
          style="background:#C9821E;color:#11201a"
          href={buyUrl}
          data-cta="comprar_certificado"
        >
          <span class="i-lucide-shopping-bag text-base" aria-hidden="true"></span>
          {lang === 'es' ? 'Comprar mi certificado' : 'Buy my certificate'}
          <span class="i-lucide-arrow-up-right text-base" aria-hidden="true"></span>
        </a>
      </p>
    </div>
    <div class="sm:col-span-2 lg:col-span-2">
      <h2 class="text-xs font-mono uppercase tracking-wider text-ink-500 mb-4">{t('footer.guias')}</h2>
      <ul class="grid gap-x-8 sm:grid-cols-2 text-sm text-ink-600 dark:text-ink-400">
        {/* `precios` y `comparativa-emisores-ecuador` concentran 8.564 impresiones/28d
            (el 27,6% del sitio) y NO estaban en ninguna navegacion sitewide: recibian
            6 y 8 enlaces internos reales frente a los 35 de /terminos/. Medido con un
            rastreo de las 68 URLs el 2026-08-24. Van primeras por volumen. */}
        <li><a class="flex items-center py-1.5 min-h-11 md:min-h-8 hover:text-ink-900 dark:hover:text-ink-50 transition-colors" href={localizedUrl('precios', lang)}>{t('guia.precios')}</a></li>
        <li><a class="flex items-center py-1.5 min-h-11 md:min-h-8 hover:text-ink-900 dark:hover:text-ink-50 transition-colors" href={localizedUrl('comparativa-emisores-ecuador', lang)}>{t('guia.comparativa-emisores')}</a></li>
        <li><a class="flex items-center py-1.5 min-h-11 md:min-h-8 hover:text-ink-900 dark:hover:text-ink-50 transition-colors" href={localizedUrl('firmar-documentos-en-linea', lang)}>{t('guia.firmar-documentos')}</a></li>
        <li><a class="flex items-center py-1.5 min-h-11 md:min-h-8 hover:text-ink-900 dark:hover:text-ink-50 transition-colors" href={localizedUrl('firma-electronica-ecuador', lang)}>{t('guia.firma-ec')}</a></li>
        <li><a class="flex items-center py-1.5 min-h-11 md:min-h-8 hover:text-ink-900 dark:hover:text-ink-50 transition-colors" href={localizedUrl('como-firmar-con-certificado-bce', lang)}>{t('guia.bce')}</a></li>
        <li><a class="flex items-center py-1.5 min-h-11 md:min-h-8 hover:text-ink-900 dark:hover:text-ink-50 transition-colors" href={localizedUrl('que-es-firma-pades', lang)}>{t('guia.pades')}</a></li>
        <li><a class="flex items-center py-1.5 min-h-11 md:min-h-8 hover:text-ink-900 dark:hover:text-ink-50 transition-colors" href={localizedUrl('comparativos-firmaec', lang)}>{t('guia.vs-firmaec')}</a></li>
        <li><a class="flex items-center py-1.5 min-h-11 md:min-h-8 hover:text-ink-900 dark:hover:text-ink-50 transition-colors" href={localizedUrl('comparativos-adobe-sign', lang)}>{t('guia.vs-adobe')}</a></li>
        <li><a class="flex items-center py-1.5 min-h-11 md:min-h-8 hover:text-ink-900 dark:hover:text-ink-50 transition-colors" href={localizedUrl('alternativa-firmaec', lang)}>{t('guia.alternativa-firmaec')}</a></li>
        <li><a class="flex items-center py-1.5 min-h-11 md:min-h-8 hover:text-ink-900 dark:hover:text-ink-50 transition-colors" href={localizedUrl('como-firmar-pdf', lang)}>{t('guia.como-firmar-pdf')}</a></li>
        <li><a class="flex items-center py-1.5 min-h-11 md:min-h-8 hover:text-ink-900 dark:hover:text-ink-50 transition-colors" href={localizedUrl('verificar-firma-pdf', lang)}>{t('guia.verificar-pdf')}</a></li>
        <li><a class="flex items-center py-1.5 min-h-11 md:min-h-8 hover:text-ink-900 dark:hover:text-ink-50 transition-colors" href={localizedUrl('validar-certificado', lang)}>{t('guia.validar-certificado')}</a></li>
        <li><a class="flex items-center py-1.5 min-h-11 md:min-h-8 hover:text-ink-900 dark:hover:text-ink-50 transition-colors" data-cta="obtener_certificado" href={localizedUrl('como-obtener-certificado', lang)}>{t('guia.obtener-certificado')}</a></li>
        <li><a class="flex items-center py-1.5 min-h-11 md:min-h-8 hover:text-ink-900 dark:hover:text-ink-50 transition-colors" href={localizedUrl('firma-electronica-empresas', lang)}>{t('guia.empresas')}</a></li>
      </ul>
    </div>
    <div>
      <h2 class="text-xs font-mono uppercase tracking-wider text-ink-500 mb-4">{t('footer.legal')}</h2>
      <ul class="text-sm text-ink-600 dark:text-ink-400">
        <li><a class="flex items-center py-1.5 min-h-11 md:min-h-8 hover:text-ink-900 dark:hover:text-ink-50 transition-colors" href={localizedUrl('privacidad', lang)}>{t('footer.privacidad')}</a></li>
        <li><a class="flex items-center py-1.5 min-h-11 md:min-h-8 hover:text-ink-900 dark:hover:text-ink-50 transition-colors" href={localizedUrl('terminos', lang)}>{t('footer.terminos')}</a></li>
        <li><a class="flex items-center py-1.5 min-h-11 md:min-h-8 hover:text-ink-900 dark:hover:text-ink-50 transition-colors" href={localizedUrl('seguridad', lang)}>{t('footer.seguridad')}</a></li>
        <li><a class="flex items-center py-1.5 min-h-11 md:min-h-8 hover:text-ink-900 dark:hover:text-ink-50 transition-colors" href={localizedUrl('contacto', lang)}>{t('footer.contacto')}</a></li>
        <li><a class="flex items-center py-1.5 min-h-11 md:min-h-8 hover:text-ink-900 dark:hover:text-ink-50 transition-colors" href={localizedUrl('glosario', lang)}>{t('footer.glosario')}</a></li>
        {lang === 'es' && (
          /* Solo en español: la sección no tiene versión en inglés, y por eso
             tampoco está en ROUTE_MAP (el href va literal). Sin este enlace el
             hub /respuestas/ solo lo alcanzan los breadcrumbs de sus propias
             páginas —un grafo cerrado sobre sí mismo— más el sitemap y
             llms.txt: el mismo argumento por el que existe el hub, un nivel
             más arriba. */
          <li><a class="flex items-center py-1.5 min-h-11 md:min-h-8 hover:text-ink-900 dark:hover:text-ink-50 transition-colors" href="/respuestas/">{t('footer.respuestas')}</a></li>
        )}
        <li><a class="flex items-center py-1.5 min-h-11 md:min-h-8 hover:text-ink-900 dark:hover:text-ink-50 transition-colors" href={localizedUrl('estadisticas', lang)}>{t('footer.estadisticas')}</a></li>
        <li><a class="flex items-center py-1.5 min-h-11 md:min-h-8 hover:text-ink-900 dark:hover:text-ink-50 transition-colors" href={localizedUrl('patrocinar', lang)}>{t('nav.patrocinar')}</a></li>
      </ul>
    </div>
    <div>
      <h2 class="text-xs font-mono uppercase tracking-wider text-ink-500 mb-4">{t('nav.repos')}</h2>
      <ul class="text-sm text-ink-600 dark:text-ink-400">
        <li><a class="flex items-center gap-2 py-1.5 min-h-11 md:min-h-8 hover:text-ink-900 dark:hover:text-ink-50 transition-colors font-mono text-xs" href={SITE.githubOrg}><span class="i-lucide-github text-sm text-ink-400 shrink-0" aria-hidden="true"></span>github.com/idkmanager</a></li>
        <li><a class="flex items-center gap-2 py-1.5 min-h-11 md:min-h-8 hover:text-ink-900 dark:hover:text-ink-50 transition-colors font-mono text-xs" href={SITE.githubPersonal}><span class="i-lucide-github text-sm text-ink-400 shrink-0" aria-hidden="true"></span>github.com/alfonsokuen</a></li>
        <li><a class="flex items-center gap-2 py-1.5 min-h-11 md:min-h-8 hover:text-ink-900 dark:hover:text-ink-50 transition-colors font-mono text-xs" href={SITE.sourceCodeRepository}><span class="i-lucide-git-branch text-sm text-ink-400 shrink-0" aria-hidden="true"></span>git.idkmanager.com</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-ink-200 dark:border-ink-800">
    <div class="container flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 py-4 text-xs text-ink-500">
      <p>© {year} firmar.ec · {t('footer.licencia')}</p>
      <p>
        <a href="/.well-known/security.txt" class="hover:text-ink-700 dark:hover:text-ink-300">security.txt</a>
      </p>
    </div>
  </div>
</footer>
