---
import { getEntry, render } from 'astro:content';
import ArticleSeo from '../layouts/ArticleSeo.astro';
import { howTo } from '../lib/jsonld.ts';

const entry = await getEntry('pages', 'es/como-firmar-con-certificado-security-data');
if (!entry) throw new Error('Missing content/pages/es/como-firmar-con-certificado-security-data.md');
const { Content } = await render(entry);
const data = entry.data;

// Mirrors the visible numbered procedure; no unmeasured completion time.
const howToData = howTo({
  name: data.h1 ?? data.title,
  description: data.description,
  steps: [
    { name: 'Abre la app', text: 'Visita app.firmar.ec/firmar en tu navegador.', url: 'https://app.firmar.ec/firmar' },
    { name: 'Selecciona el PDF y coloca la firma visible', text: 'Elige la página y la posición del cuadro de firma.' },
    { name: 'Selecciona tu certificado', text: 'Carga el archivo .p12 o .pfx de Security Data.' },
    { name: 'Comprueba la contraseña y firma', text: 'Introduce la contraseña del archivo, revisa el titular y el resumen, y pulsa Firmar PDF.' },
    { name: 'Descarga y verifica', text: 'Guarda el PDF firmado y comprueba su firma antes de entregarlo.' },
  ],
});

const articleProps = {
  title: data.title,
  description: data.description,
  routeKey: 'como-firmar-con-certificado-security-data',
  h1: data.h1 ?? data.title,
  datePublished: data.datePublished,
  ...(data.dateModified !== undefined ? { dateModified: data.dateModified } : {}),
  breadcrumbs: data.breadcrumbs,
  related: data.related,
  faq: data.faq,
};
---
<ArticleSeo {...articleProps}>
  <Content />
  <script type="application/ld+json" set:html={JSON.stringify(howToData)}></script>
</ArticleSeo>
