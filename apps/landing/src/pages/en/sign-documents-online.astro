---
import { getEntry, render } from 'astro:content';
import ArticleSeo from '../../layouts/ArticleSeo.astro';
import { howTo } from '../../lib/jsonld.ts';

const entry = await getEntry('pages', 'en/sign-documents-online');
if (!entry) throw new Error('Missing content/pages/en/sign-documents-online.md');
const { Content } = await render(entry);
const data = entry.data;

// Mirrors the visible numbered procedure; no unmeasured completion time.
const howToData = howTo({
  name: data.h1 ?? data.title,
  description: data.description,
  steps: [
    { name: 'Open the app', text: 'Visit app.firmar.ec/firmar in your browser.', url: 'https://app.firmar.ec/firmar' },
    { name: 'Select the PDF and place the visible signature', text: 'Choose the page and position of the signature box.' },
    { name: 'Select your certificate', text: 'Load the .p12 or .pfx file belonging to the person who must sign.' },
    { name: 'Check the password and sign', text: "Enter the file's password, review the holder and summary, and press Sign PDF." },
    { name: 'Download and verify', text: 'Save the signed PDF and check its signature before submitting it.' },
  ],
});

const articleProps = {
  title: data.title,
  description: data.description,
  routeKey: 'firmar-documentos-en-linea',
  h1: data.h1 ?? data.title,
  datePublished: data.datePublished,
  ...(data.dateModified !== undefined ? { dateModified: data.dateModified } : {}),
  breadcrumbs: data.breadcrumbs,
  related: data.related,
  faq: data.faq,
};
---
<ArticleSeo {...articleProps}>
  <Content />
  <script type="application/ld+json" set:html={JSON.stringify(howToData)}></script>
</ArticleSeo>
