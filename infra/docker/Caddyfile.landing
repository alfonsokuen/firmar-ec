{
  auto_https off
  admin off
  servers {
    protocols h1 h2 h3
    timeouts {
      read_body 10s
      read_header 5s
      write 10s
      idle 30s
    }
  }
}

:8080 {
  root * /srv
  encode zstd gzip
  file_server {
    precompressed br gzip
  }

  header {
    Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    # cloudflareinsights.com allowed: Cloudflare Web Analytics beacon is injected
    # at the CF edge; without this the beacon is CSP-blocked and no traffic data
    # is collected (SEO/measurement fix 2026-05-23).
    Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
    X-Frame-Options "DENY"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), clipboard-write=(), interest-cohort=()"
    Cross-Origin-Opener-Policy "same-origin"
    Cross-Origin-Embedder-Policy "require-corp"
    Cross-Origin-Resource-Policy "same-origin"
    # X-Robots-Tag lifted 2026-05-08 (F1 v0.1.0) — site indexable from now on
    -Server
  }

  @hashed path_regexp ^/_astro/.*\.[a-f0-9]{8,}\.(js|css|woff2|svg|png|jpg|webp|avif)$
  header @hashed Cache-Control "public, max-age=31536000, immutable"

  @html path *.html /
  header @html Cache-Control "public, max-age=300, must-revalidate"

  @securitytxt path /.well-known/security.txt
  header @securitytxt Content-Type "text/plain; charset=utf-8"

  redir /.well-known/change-password https://www.eci.bce.fin.ec/ permanent

  # PWA route redirects — landing has no /firmar /verificar /paranoia routes;
  # they live in app.firmar.ec (hash-routed PWA). Added v0.1.4 (2026-05-09).
  # Preserve the query before the hash, including encoded/repeated parameters.
  map {query} {pwa_query} {
    "" ""
    default "?{query}"
  }
  redir /firmar https://app.firmar.ec/{pwa_query}#/firmar permanent
  redir /firmar/* https://app.firmar.ec/{pwa_query}#/firmar permanent
  redir /verificar https://app.firmar.ec/#/verificar permanent
  redir /verificar/* https://app.firmar.ec/#/verificar permanent
  redir /paranoia https://app.firmar.ec/#/paranoia permanent
  redir /paranoia/* https://app.firmar.ec/#/paranoia permanent

  # EN PWA route redirects — los CTA de la home EN apuntan a /en/sign y /en/verify
  # (ROUTE_MAP en src/i18n/utils.ts), que no son páginas del landing sino redirects
  # a la PWA, igual que /firmar /verificar en ES. Faltaban → 404 en los 2 CTA
  # principales de la versión inglesa (2 errores 404 en GSC). Espejo del bloque ES.
  # Added v0.1.27 (2026-05-25).
  redir /en/sign https://app.firmar.ec/{pwa_query}#/firmar permanent
  redir /en/sign/* https://app.firmar.ec/{pwa_query}#/firmar permanent
  redir /en/verify https://app.firmar.ec/#/verificar permanent
  redir /en/verify/* https://app.firmar.ec/#/verificar permanent

  # Defensive: la guía EN vive en /en/electronic-signature-ecuador/, no en el
  # slug ES bajo /en/ (alguien podría prefijar /en/ manualmente). 2026-05-23.
  redir /en/firma-electronica-ecuador /en/electronic-signature-ecuador/ permanent
  redir /en/firma-electronica-ecuador/ /en/electronic-signature-ecuador/ permanent

  handle_errors {
    respond "{err.status_code}" {err.status_code}
  }
}
