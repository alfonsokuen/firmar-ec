{
  auto_https off
  admin off
  servers {
    protocols h1 h2 h3
    timeouts {
      read_body 10s
      read_header 5s
      write 10s
      idle 30s
    }
  }
}

:8080 {
  root * /srv
  encode zstd gzip

  # ──────────────────────────────────────────────────────────────────────────
  # Security headers — strict for app.firmar.ec (PWA, in-browser crypto)
  # ──────────────────────────────────────────────────────────────────────────
  header {
    Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

    # CSP rationale:
    # - 'wasm-unsafe-eval' enables WebCrypto-adjacent WASM (asn1js/pkijs paths if used).
    # - connect-src includes ocsp.firmar.ec for live OCSP queries via the CF Worker proxy.
    # - connect-src includes freetsa.org (F6) for the default RFC 3161 TSA round-trip.
    #   Power users that point /configuracion at a self-hosted TSA (e.g. ARCOTEL
    #   when accredited endpoints publish RFC 3161) MUST also widen this CSP at
    #   deploy time — Configuracion.svelte surfaces a warn-tier hint when the URL
    #   diverges from the default. We deliberately do NOT use connect-src https:
    #   wildcard: keeping the allowlist explicit preserves the SSL-Labs A+ posture.
    #
    # F7 LTV (2026-05-10) — OCSP / CRL fetches:
    # - The B-LT pipeline (collectLtvData) issues HTTP requests against
    #   responder URLs discovered via cert AIA (OCSP) and CRLDistributionPoints
    #   (CRL). Both targets are arbitrary per-issuer URLs (eci.bce.fin.ec,
    #   ocsp.argosdata.com.ec, …) and cannot be enumerated at build time.
    # - Default behaviour: the user-side CF Worker proxy at `ocsp.firmar.ec`
    #   (already in connect-src) is the recommended path — operators wire
    #   their accredited ACE endpoints behind that worker and the browser
    #   only ever talks to `https://ocsp.firmar.ec`.
    # - Users that override the OCSP/CRL URL in /configuracion to point at a
    #   raw responder URL MUST coordinate a Caddyfile update with the
    #   operator. The UI surfaces a warn hint near that field.
    # - Future enhancement (tracked in spec §10.5 out-of-scope): same-origin
    #   `/api/ocsp?url=<encoded>` and `/api/crl?url=<encoded>` reverse-proxy
    #   blocks with a curated allowlist of known ARCOTEL ACE responders.
    #   Not landed in F7 — risk/benefit deferred until the accredited list
    #   stabilises post-TSL v1.1.0.
    # - worker-src 'self' blob: allows the verify Web Worker (chunked ES module).
    # - require-trusted-types-for 'script' hardens against DOM XSS sinks.
    # - form-action 'self' is intentional (PWA may post to its own routes).
    # script-src 'unsafe-inline' is required for the Trusted Types default policy
    # bootstrap script (hotfix v0.2.1). TODO: replace with sha256-* hash once Vite
    # build pipeline emits a stable inline-script digest. Trusted Types still
    # restricts script-URL sinks (createScriptURL) — XSS surface stays minimal.
    Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://ocsp.firmar.ec https://freetsa.org {$CSP_CONNECT_EXTRA}; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'self' https://app.3tap.ec; upgrade-insecure-requests; require-trusted-types-for 'script'"

    # Sin X-Frame-Options: la lista de quien puede embeber vive en
    # `frame-ancestors` (arriba). 3tap (app.3tap.ec) embebe la app de firma en
    # su pestana «Firmar documentos»; XFO no admite lista y DENY la pisaria.
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"

    # Permissions-Policy — landing baseline + extra sensor/feature lockdown.
    # Anything that could leak side-channel data on a crypto surface is denied.
    # v0.4.0 — web-share=(self) re-enabled so the PWA can act as a Share Target
    # and use navigator.share() for the "Share signed PDF" CTA on /firmar.
    # All other intrusive sensors stay denied.
    Permissions-Policy "accelerometer=(), ambient-light-sensor=(), attribution-reporting=(), autoplay=(), bluetooth=(), browsing-topics=(), camera=(), clipboard-read=(), clipboard-write=(self), display-capture=(), document-domain=(), encrypted-media=(), fullscreen=(), gamepad=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), interest-cohort=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), otp-credentials=(), payment=(), picture-in-picture=(), publickey-credentials-create=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), speaker-selection=(), storage-access=(), sync-xhr=(), usb=(), web-share=(self), window-management=(), xr-spatial-tracking=()"

    Cross-Origin-Opener-Policy "same-origin"
    # F6: relaxed from require-corp → credentialless so the FreeTSA RFC 3161
    # round-trip (which doesn't ship CORP/CORS headers) is not blocked by COEP.
    # We don't use SharedArrayBuffer in production code paths, only defensive
    # type casts; cross-origin isolation guarantee is reduced but acceptable
    # given the TSA fetch happens with no credentials and is opaque to JS
    # cross-origin (response is parsed as binary CMS bytes).
    Cross-Origin-Embedder-Policy "credentialless"
    Cross-Origin-Resource-Policy "same-origin"

    # Allow the SW to control the entire origin from /sw.js.
    Service-Worker-Allowed "/"

    X-Robots-Tag "noindex, nofollow"
    -Server
  }

  # ──────────────────────────────────────────────────────────────────────────
  # Cache policy
  # ──────────────────────────────────────────────────────────────────────────
  # Hashed Vite assets (8+ hex chars before extension) — immutable for 1y.
  @hashed path_regexp ^/assets/.*-[A-Za-z0-9_-]{8,}\.(js|css|woff2|svg|png|jpg|webp|avif|map)$
  header @hashed Cache-Control "public, max-age=31536000, immutable"

  # Service Worker + Workbox runtime: must always revalidate, never stale.
  @sw path /sw.js /workbox-*.js /registerSW.js
  header @sw Cache-Control "no-cache, no-store, must-revalidate, max-age=0"

  # Trust list: must always be fresh (security-critical, revocation list).
  @trust path /trust/tsl-ec.json /trust/tsl-ec.sha256
  header @trust Cache-Control "no-cache, no-store, must-revalidate, max-age=0"

  # PWA manifest: short cache, allow updates.
  @manifest path /manifest.webmanifest
  header @manifest Cache-Control "public, max-age=3600, must-revalidate"

  # index.html and SPA fallback root: no-cache (must always check for updates).
  @html path *.html /
  header @html Cache-Control "no-cache, must-revalidate"

  # ──────────────────────────────────────────────────────────────────────────
  # F6: Same-origin TSA proxy + SPA fallback
  # FreeTSA does not ship CORS headers, so a direct browser fetch fails
  # preflight. /api/tsa reverse-proxies the RFC 3161 round-trip same-origin.
  # `route` is used because mixing bare directives with `handle` blocks
  # inside the same site is order-sensitive in Caddy v2 — explicit routing
  # makes the dispatch deterministic.
  # ──────────────────────────────────────────────────────────────────────────
  route {
    # PWA install opt-out (handoff instances only): 404 the web manifest so the
    # browser does NOT offer to "install firmar.ec" from a one-shot signing
    # surface (firma.idkmanager.com). The public app leaves HANDOFF_NO_MANIFEST
    # unset, so the matcher path defaults to a sentinel that never matches and
    # the manifest is served normally (install stays enabled on app.firmar.ec).
    @no_manifest path {$HANDOFF_NO_MANIFEST:/__manifest_enabled__}
    respond @no_manifest 404

    # F6 TSA proxy must come before any file_server that would 405 a POST.
    @tsapost {
      path /api/tsa
      method POST
      header Content-Type application/timestamp-query
    }
    reverse_proxy @tsapost https://freetsa.org {
      rewrite /tsr
      header_up Host freetsa.org
      header_up -Origin
      header_up -Referer
      transport http {
        tls
        tls_server_name freetsa.org
      }
    }
    @tsa_notpost {
      path /api/tsa
      not method POST
    }
    respond @tsa_notpost 405

    # ──────────────────────────────────────────────────────────────────────────
    # F7.5 — /api/ocsp/* and /api/crl/* allowlisted reverse proxies
    # ──────────────────────────────────────────────────────────────────────────
    # Why same-origin proxy:
    #   1. ARCOTEL ACE responders rarely ship CORS headers; direct browser
    #      fetch fails preflight.
    #   2. Privacy/LOPDP: upstream sees only the firmar.ec edge IP, not the
    #      end-user. Acts as a small but meaningful anonymising layer.
    #
    # Allowlist-only: every entry below MUST have a matching key in
    # packages/ltv-validation/src/proxy.ts (ARCOTEL_PROXY_MAP). An open
    # `?url=<encoded>` rewrite would be an SSRF vector — deliberately avoided.
    #
    # Coverage (2/17 ARCOTEL ACEs, both confirmed reachable 2026-05-10):
    #   /api/ocsp/securitydata → http://ocspgw.securitydata.net.ec/ejbca/publicweb/status/ocsp
    #   /api/ocsp/argosdata    → http://ocsp.argosdata.com.ec
    #   /api/crl/securitydata  → http://crl1.securitydata.net.ec/subca2crl1/crlfile.crl
    #   /api/crl/argosdata     → http://crl.argosdata.com.ec/crl/0cdaea45-...-7d4797ea00a4.crl
    # Remaining 15 ACEs ship as their AIA URLs publish.

    # SECURITY DATA SubCA-2 — OCSP (POST, application/ocsp-request)
    @ocsp_securitydata {
      path /api/ocsp/securitydata
      method POST
      header Content-Type application/ocsp-request
    }
    reverse_proxy @ocsp_securitydata http://ocspgw.securitydata.net.ec {
      rewrite /ejbca/publicweb/status/ocsp
      header_up Host ocspgw.securitydata.net.ec
      header_up -Origin
      header_up -Referer
    }

    # ArgosData CA 1 — OCSP
    @ocsp_argosdata {
      path /api/ocsp/argosdata
      method POST
      header Content-Type application/ocsp-request
    }
    reverse_proxy @ocsp_argosdata http://ocsp.argosdata.com.ec {
      rewrite /
      header_up Host ocsp.argosdata.com.ec
      header_up -Origin
      header_up -Referer
    }

    # SECURITY DATA SubCA-2 — CRL (GET, ~1.19 MB DER)
    @crl_securitydata {
      path /api/crl/securitydata
      method GET
    }
    reverse_proxy @crl_securitydata http://crl1.securitydata.net.ec {
      rewrite /subca2crl1/crlfile.crl
      header_up Host crl1.securitydata.net.ec
      header_up -Origin
      header_up -Referer
    }

    # ArgosData CA 1 — CRL
    @crl_argosdata {
      path /api/crl/argosdata
      method GET
    }
    reverse_proxy @crl_argosdata http://crl.argosdata.com.ec {
      rewrite /crl/0cdaea45-3374-42ca-9248-7d4797ea00a4.crl
      header_up Host crl.argosdata.com.ec
      header_up -Origin
      header_up -Referer
    }

    # F1 — UANATACA AIA caIssuers (missing-intermediate fallback, GET).
    # URL extracted via extractCaIssuersUrls() from a REAL UANATACA leaf
    # fixture (packages/verifier/tests/fixtures/leaf-uanataca.der), not typed
    # in by hand — see packages/ltv-validation/src/proxy.ts and aia-certs.ts.
    @aia_uanataca {
      path /api/aia/uanataca
      method GET
    }
    reverse_proxy @aia_uanataca http://www.uanataca.com {
      rewrite /public/download/tsp_certificates/subordinate1.crt
      header_up Host www.uanataca.com
      header_up -Origin
      header_up -Referer
    }

    # F1 HIGH-1b (2026-08-05) — UANATACA CA2 2016 (subordinate2.crt), the
    # real issuer of leaf-uanataca.der (confirmed via OpenSSL — see
    # packages/ltv-validation/src/proxy.ts module header). Kept as a separate
    # route/allowlist entry from subordinate1.crt above, not an alias.
    @aia_uanataca_ca2 {
      path /api/aia/uanataca-ca2
      method GET
    }
    reverse_proxy @aia_uanataca_ca2 http://www.uanataca.com {
      rewrite /public/download/tsp_certificates/subordinate2.crt
      header_up Host www.uanataca.com
      header_up -Origin
      header_up -Referer
    }

    # F2 (2026-08-06) — UANATACA TSA-issuing CA (AIA caIssuers fallback for
    # the sello-de-tiempo verify path, same mechanism as F1 above but for
    # RFC 3161 tokens). Different host/path scheme than the F1 entries above
    # — UANATACA's newer cert batches (CA2 2021, and this CA1 2021 used for
    # timestamping) publish AIA under web.uanataca.com/common/project/pdf/...
    # instead of the older www.uanataca.com/public/download/... form. See
    # packages/tsa-trust/src/intermediates.ts for the forensic provenance.
    @aia_uanataca_tsa_ca1 {
      path /api/aia/uanataca-tsa-ca1
      method GET
    }
    reverse_proxy @aia_uanataca_tsa_ca1 https://web.uanataca.com {
      rewrite /common/project/pdf/autoridad-certificacion/07_subordinada-ca1-2021.cer
      header_up Host web.uanataca.com
      header_up -Origin
      header_up -Referer
    }

    # Reject non-allowlisted /api/ocsp/*, /api/crl/*, /api/aia/* paths
    # explicitly so they don't silently fall through to the SPA fallback.
    @ltv_unknown path_regexp ^/api/(ocsp|crl|aia)/.+
    respond @ltv_unknown 404

    # ──────────────────────────────────────────────────────────────────────────
    # v0.7.30 — Hashed assets serve-or-404, NEVER SPA-fallback.
    # ──────────────────────────────────────────────────────────────────────────
    # A stale Service Worker (client that hasn't accepted the update prompt) can
    # request a chunk hash that this deploy already purged (e.g. an old
    # verify.worker-XXXX.js or roots-YYYY.js). The generic SPA `try_files …
    # /index.html` below would answer such a miss with index.html (HTML, 200).
    # A module/worker `import()` that receives HTML instead of JS fails to parse
    # AND — for module-worker dependency loads — does not reliably fire
    # `worker.onerror` in Chromium, so the verify worker dies silently and the
    # UI spins forever (reported on Android Chrome 2026-05-20). Returning a real
    # 404 lets the import reject, the worker post an error, and the UI surface a
    # "reload to update" message so stale clients self-heal.
    @assets path /assets/*
    file_server @assets {
      precompressed br gzip
    }

    # SPA fallback for client-side routes (Verificar, Firmar, Paranoia, etc.)
    try_files {path} /index.html
    file_server {
      precompressed br gzip
    }
  }

  handle_errors {
    # La politica de cache de arriba se aplica por RUTA, y Caddy la evalua antes
    # de saber si el fichero existe: un 404 bajo /assets/ salia con el mismo
    # `max-age=31536000, immutable` que un chunk real. Durante un rolling update
    # start-first conviven la replica vieja y la nueva unos segundos, asi que una
    # peticion al chunk NUEVO puede caer en la VIEJA y recibir 404 — y ese 404 se
    # quedaba cacheado un ANO en Cloudflare y en el navegador (que con
    # `immutable` ni siquiera revalida). El cliente veia la app en blanco hasta
    # que expirase. Ocurrio de verdad en el deploy de la 0.26.0 (2026-09-09).
    # Un error nunca es cacheable: se sobrescribe la cabecera aqui, que es el
    # unico punto por el que pasan TODAS las respuestas de error.
    header Cache-Control "no-store"
    respond "{err.status_code}" {err.status_code}
  }
}
